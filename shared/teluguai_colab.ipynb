   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# TeluguAI — IndicF5 TTS Colab\n",
    "**Restart session → Run All.**\n",
    "\n",
    "After execution, copy the Cloudflare URL and update `INDICF5_URL` in `VoiceDemo.tsx`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import files\n",
    "import os, sys, subprocess, time, json, threading, base64, io, logging\n",
    "\n",
    "logging.basicConfig(level=logging.INFO)\n",
    "logger = logging.getLogger('teluguai')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Install Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Installing dependencies...')\n",
    "!pip install -q torch torchaudio transformers soundfile numpy==1.26.4 fastapi uvicorn nest-asyncio pyngrok cloudflared 2>&1 | tail -5\n",
    "print('Done')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Upload Prompt Audio Files\n",
    "\n",
    "Upload **3 WAV files**: `TEL_F_SHANTHI.wav`, `TEL_M_BHASKAR.wav`, `TEL_M_DEVA.wav`"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!mkdir -p /content/prompts\n",
    "\n",
    "print('Upload prompt audio files (select all 3 WAV files at once):')\n",
    "uploaded = files.upload()\n",
    "\n",
    "for name, content in uploaded.items():\n",
    "    with open(f'/content/prompts/{name}', 'wb') as f:\n",
    "        f.write(content)\n",
    "    print(f'  Saved: /content/prompts/{name} ({len(content)} bytes)')\n",
    "\n",
    "print(f'\\nFiles in /content/prompts/:')\n",
    "!ls -lh /content/prompts/"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Load IndicF5 Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from transformers import AutoModel\n",
    "\n",
    "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(f'Using device: {device}')\n",
    "\n",
    "print('Loading IndicF5 model...')\n",
    "model = AutoModel.from_pretrained('ai4bharat/IndicF5', trust_remote_code=True)\n",
    "model.to(device)\n",
    "model.eval()\n",
    "print('Model loaded!')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Start FastAPI Server"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "%%writefile /content/server.py\n",
    "import os, io, base64, logging\n",
    "import numpy as np\n",
    "import soundfile as sf\n",
    "import torch\n",
    "from fastapi import FastAPI, HTTPException\n",
    "from fastapi.middleware.cors import CORSMiddleware\n",
    "from pydantic import BaseModel\n",
    "from typing import Optional\n",
    "\n",
    "app = FastAPI()\n",
    "app.add_middleware(CORSMiddleware, allow_origins=['*'], allow_credentials=True, allow_methods=['*'], allow_headers=['*'])\n",
    "\n",
    "logging.basicConfig(level=logging.INFO)\n",
    "logger = logging.getLogger('tts')\n",
    "\n",
    "class TTSRequest(BaseModel):\n",
    "    gen_text: str\n",
    "    ref_audio: str\n",
    "    ref_text: str = '\u0c24\u0c46\u0c32\u0c41\u0c17\u0c41 \u0c2d\u0c3e\u0c37 \u0c2e\u0c3e\u0c1f\u0c4d\u0c32\u0c3e\u0c21\u0c47 \u0c35\u0c4d\u0c2f\u0c15\u0c4d\u0c24\u0c41\u0c32 \u0c15\u0c4b\u0c38\u0c02 \u0c08 \u0c38\u0c47\u0c35 \u0c30\u0c42\u0c2a\u0c02\u0c26\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f."\n",
    "\n",
    "model_instance = None\n",
    "\n",
    "@app.on_event('startup')\n",
    "async def startup():\n",
    "    global model_instance\n",
    "    import __main__\n",
    "    model_instance = __main__.model\n",
    "    logger.info('TTS model attached')\n",
    "\n",
    "@app.get('/health')\n",
    "async def health():\n",
    "    return {'status': 'ok', 'device': str(model_instance.device) if model_instance else 'none'}\n",
    "\n",
    "@app.post('/tts')\n",
    "async def tts(req: TTSRequest):\n",
    "    global model_instance\n",
    "    if model_instance is None:\n",
    "        raise HTTPException(503, 'Model not loaded')\n",
    "    try:\n",
    "        ref_path = req.ref_audio\n",
    "        if not os.path.exists(ref_path):\n",
    "            raise HTTPException(400, f'Reference audio not found: {ref_path}')\n",
    "        with torch.no_grad():\n",
    "            audio = model_instance(req.gen_text, ref_audio_path=ref_path, ref_text=req.ref_text)\n",
    "        if isinstance(audio, torch.Tensor):\n",
    "            audio = audio.cpu().numpy()\n",
    "        if audio.dtype == np.int16:\n",
    "            audio = audio.astype(np.float32) / 32768.0\n",
    "        audio = np.clip(audio, -1.0, 1.0)\n",
    "        buf = io.BytesIO()\n",
    "        sf.write(buf, audio, 24000, format='wav')\n",
    "        b64 = base64.b64encode(buf.getvalue()).decode()\n",
    "        return {'audio': b64, 'sample_rate': 24000, 'duration': round(len(audio)/24000, 2)}\n",
    "    except Exception as e:\n",
    "        logger.error(f'TTS failed: {e}')\n",
    "        raise HTTPException(500, str(e))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import nest_asyncio\n",
    "nest_asyncio.apply()\n",
    "\n",
    "import uvicorn\n",
    "\n",
    "def run_server():\n",
    "    uvicorn.run('server:app', host='0.0.0.0', port=8000, log_level='info')\n",
    "\n",
    "thread = threading.Thread(target=run_server, daemon=True)\n",
    "thread.start()\n",
    "time.sleep(2)\n",
    "print('Server started on http://localhost:8000')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Quick health check\n",
    "!curl -s http://localhost:8000/health | python3 -m json.tool"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Start Cloudflare Tunnel"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print('Starting Cloudflare tunnel...')\n",
    "import subprocess\n",
    "process = subprocess.Popen(\n",
    "    ['cloudflared', 'tunnel', '--url', 'http://localhost:8000'],\n",
    "    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True\n",
    ")\n",
    "\n",
    "# Wait for tunnel URL\n",
    "tunnel_url = None\n",
    "while True:\n",
    "    line = process.stdout.readline()\n",
    "    if not line:\n",
    "        break\n",
    "    print(line, end='')\n",
    "    if 'trycloudflare.com' in line:\n",
    "        import re\n",
    "        m = re.search(r'https://[a-z0-9-]+\\.trycloudflare\\.com', line)\n",
    "        if m:\n",
    "            tunnel_url = m.group()\n",
    "            break\n",
    "\n",
    "print('\\n' + '='*60)\n",
    "print(f'  TUNNEL URL: {tunnel_url}')\n",
    "print('='*60)\n",
    "print()\n",
    "print(f'Update INDICF5_URL in VoiceDemo.tsx to:')\n",
    "print(f'  const INDICF5_URL = \\'{tunnel_url}\\'')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
